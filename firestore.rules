
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper
    function isAdmin() {
      return request.auth != null;
    }

    // Explicitly allow specific collections
    match /organizations/{document=**} {
      allow read, write: if true;
    }
    
    match /email_templates/{document=**} {
      allow read, write: if true;
    }

    match /hub_items/{document=**} {
      allow read, write: if true;
    }

    match /hub_sections/{document=**} {
      allow read, write: if true;
    }

    // Default catch-all for development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
